<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_account_payment_form_inherit_l10n_pl" model="ir.ui.view">
            <field name="name">account.payment.form.inherit</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@id='partner_bank_id_vendor']" position="attributes">
                    <attribute name="readonly">l10n_pl_bank_verification_status != 'not_required' and state != 'draft'</attribute>
                </xpath>
                <xpath expr="//group[@name='group2']" position="after">
                    <group name="group_bank_account_verification" string="Bank verification" invisible="l10n_pl_bank_verification_status == 'not_required'">
                        <field name="l10n_pl_bank_verification_status"/>
                        <field name="l10n_pl_bank_verification_timestamp"/>
                        <field name="l10n_pl_bank_verification_request_id" invisible="not l10n_pl_bank_verification_request_id"/>
                        <field name="l10n_pl_bank_verification_fail_reason" invisible="l10n_pl_bank_verification_status != 'failed'"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
