<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="delivery_note_form_view" model="ir.ui.view">
        <field name="name">delivery.note.form</field>
        <field name="model">delivery.note</field>
        <field name="arch" type="xml">
            <form string="Delivery Note">
                <sheet>
                    <field name="note_line_ids"/>
                    <group>
                        <group name="tracking_details">
                            <field
                                name="carrier_id"
                                options="{'no_open': True, 'no_create': True}"
                            />
                            <field name="carrier_tracking_ref"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button
                        string="Confirm Shipment"
                        name="action_confirm"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        string="Discard"
                        name="action_cancel"
                        type="object"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>

</odoo>
