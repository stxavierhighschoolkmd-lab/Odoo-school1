<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="hr_attendance.AttendanceReviewBlock">
    <div t-if="review" class="o_attendance_review_wrap">
        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
            <div>
                <div class="text-uppercase small fw-semibold text-muted">Attendance Review</div>
                <div class="small text-muted">
                    <t t-out="review.dateLabel"/>
                </div>
            </div>
            <t t-if="isEditingReview and onSaveInlineEdit and onCancelInlineEdit">
                <div class="o_attendance_review_header_actions">
                    <button class="btn btn-primary btn-sm"
                            t-att-disabled="editState.savingAttendance"
                            t-on-click="() => onSaveInlineEdit()">
                        Save
                    </button>
                    <button class="btn btn-secondary btn-sm"
                            t-att-disabled="editState.savingAttendance"
                            t-on-click="() => onCancelInlineEdit()">
                        Cancel
                    </button>
                </div>
            </t>
            <button t-elif="review.canEdit and onStartInlineEdit"
                    class="btn btn-link btn-sm p-0 text-decoration-none"
                    t-on-click="() => onStartInlineEdit(review.id)">
                Edit
            </button>
        </div>

        <div class="o_attendance_review_grid mb-3">
            <div t-foreach="review.entries" t-as="entry" t-key="entry.key" class="o_attendance_review_card">
                <div class="small text-uppercase fw-semibold text-muted mb-2">
                    <t t-out="entry.label"/>
                </div>
                <t t-if="isEditingReview and entry.key === 'check_in'">
                    <TimePicker inputCssClass="'form-control-sm o_attendance_review_input'"
                                value="this._getInlineTimeValue(editState.editDraft.checkIn)"
                                onChange="(value) => onUpdateInlineDateTimeDraft('checkIn', value)"
                                onInvalid="() => onUpdateInlineDateTimeDraft('checkIn', null)"
                                showSeconds="false"
                                minutesRounding="1"/>
                </t>
                <t t-elif="isEditingReview and entry.key === 'check_out'">
                    <TimePicker inputCssClass="'form-control-sm o_attendance_review_input'"
                                value="this._getInlineTimeValue(editState.editDraft.checkOut)"
                                onChange="(value) => onUpdateInlineDateTimeDraft('checkOut', value)"
                                onInvalid="() => onUpdateInlineDateTimeDraft('checkOut', null)"
                                showSeconds="false"
                                minutesRounding="1"/>
                    <div t-if="review.showBreakSummary and editState.editDraft.checkOut"
                        class="o_attendance_review_break_editor mt-2">
                        <label class="small text-uppercase fw-semibold text-muted mb-1">
                            Break duration
                        </label>
                        <div class="o_attendance_review_break_row">
                            <input class="form-control form-control-sm o_attendance_review_break_input"
                                   type="number"
                                   min="0"
                                   step="0.01"
                                   inputmode="decimal"
                                   t-model="editState.editDraft.breakDuration"
                                   t-att-disabled="editState.savingAttendance || !editState.editDraft.checkOut"/>
                            <span class="small text-muted o_attendance_review_break_unit">Hours</span>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <div class="fs-4 fw-semibold o_attendance_review_time" t-att-class="entry.pending ? 'text-muted' : ''">
                        <t t-out="entry.time"/>
                    </div>
                </t>
                <div class="small text-muted o_attendance_review_location" t-if="entry.location">
                    <t t-out="entry.location"/>
                </div>
            </div>
        </div>


        <div t-if="review.sessions and review.sessions.length" class="o_attendance_review_sessions">
            <div t-foreach="review.sessions"
                 t-as="session"
                 t-key="session.id"
                 class="o_attendance_review_session"
                 t-att-class="(session.selected ? 'o_is_selected ' : '') + (onSelectAttendance ? 'o_is_selectable' : '')"
                 t-on-click="() => onSelectAttendance &amp;&amp; onSelectAttendance(session.id)">
                <span class="o_attendance_review_session_range">
                    <t t-out="session.rangeLabel"/>
                </span>
                <strong class="o_attendance_review_session_duration">
                    <t t-out="session.durationLabel"/>
                </strong>
            </div>
        </div>

        <div class="o_attendance_review_summary">
            <div t-if="review.showBreakSummary" class="o_attendance_review_summary_item">
                <strong class="o_attendance_review_summary_value">
                    <t t-out="getReviewBreakDisplay ? getReviewBreakDisplay(review) : review.breakDisplay"/>
                </strong>
                <span class="o_attendance_review_summary_label">Breaks</span>
            </div>
            <div class="o_attendance_review_summary_item" t-att-class="!review.showBreakSummary ? 'w-100' : ''">
                <strong class="o_attendance_review_summary_value">
                    <t t-out="getReviewTotalDisplay ? getReviewTotalDisplay(review) : review.totalDisplay"/>
                </strong>
                <span class="o_attendance_review_summary_label">Total hours</span>
            </div>
        </div>
    </div>
</t>

<t t-name="hr_attendance.attendance_menu">
    <t t-if="this.state.isDisplayed">
        <Dropdown position="'bottom-end'"
                  beforeOpen.bind="this.searchReadEmployee"
                  menuClass="'p-0'"
                  state="this.dropdown">
            <button>
                <i class="fa fa-circle"
                   t-attf-class="text-{{ this.state.checkedIn ? 'success' : 'danger' }}"
                   role="img"
                   aria-label="Attendance"/>
            </button>

            <t t-set-slot="content">
                <div class="att_container d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center gap-5 border-bottom p-3">
                        <h3 class="mb-0">
                            <t t-if="this.hasCheckedInToday">
                                <small>Welcome back</small> <span class="d-block"><t t-out="this.employeeName"/>!</span>
                            </t>
                            <t t-else="">
                                <small>Welcome,</small> <span class="d-block"><t t-out="this.employeeName"/>.</span>
                            </t>
                        </h3>
                    </div>

                    <div class="o_att_today_wrap px-3">
                        <t t-set="review" t-value="this.attendanceReview"/>
                        <t t-set="editState" t-value="this.state"/>
                        <t t-set="isEditingReview" t-value="this.isEditingReview(this.attendanceReview)"/>
                        <t t-set="onStartInlineEdit" t-value="(attendanceId) => this.startInlineEdit(attendanceId)"/>
                        <t t-set="onCancelInlineEdit" t-value="() => this.cancelInlineEdit()"/>
                        <t t-set="onSaveInlineEdit" t-value="() => this.saveInlineEdit()"/>
                        <t t-set="onSelectAttendance" t-value="(attendanceId) => this.selectAttendance(attendanceId)"/>
                        <t t-set="onUpdateInlineDateTimeDraft"
                           t-value="(fieldName, value) => this.updateInlineDateTimeDraft(fieldName, value)"/>
                        <t t-set="getReviewBreakDisplay" t-value="(review) => this.getReviewBreakDisplay(review)"/>
                        <t t-set="getReviewTotalDisplay" t-value="(review) => this.getReviewTotalDisplay(review)"/>
                        <t t-call="hr_attendance.AttendanceReviewBlock"/>
                    </div>

                    <div class="o_wrap_btn_sign_out o_attendance_review_actions position-md-sticky bottom-0 p-3 z-2">
                        <button t-on-click="() => this.signInOut()"
                                class="btn btn-primary flex-grow-1">
                            <span t-if="!this.state.checkedIn">Check in</span>
                            <span t-else="">Check out</span>
                            <i t-attf-class="fa fa-sign-{{ this.state.checkedIn ? 'out' : 'in' }} ms-1"/>
                        </button>
                        <button t-on-click="() => this.dropdown.close()"
                                class="btn btn-secondary">
                            Discard
                        </button>
                    </div>
                </div>
            </t>
        </Dropdown>
    </t>
</t>

</templates>
