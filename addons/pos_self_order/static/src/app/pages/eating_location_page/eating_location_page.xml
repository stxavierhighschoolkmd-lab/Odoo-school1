<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve" >
    <t t-name="pos_self_order.EatingLocationPage">
        <div class="o_self_eating_location_box d-flex flex-column vh-100 overflow-hidden o_self_background o_self_fade" t-attf-style="background-image:#{this.selfOrder.kioskBackgroundImageUrl};background-size: cover; background-position: center;">
            <div class="d-flex flex-column flex-grow-1 overflow-y-auto" t-custom-ref="scrollContainer">
               <div class="container o_self_container my-auto">
                   <h1 class="text-center mt-4 mb-4">Where do you want to eat?</h1>
                   <div t-if="this.ui.size gt SIZES.MD" class="grid gap-3" t-att-class="{'d-flex justify-content-center': this.presets.length === 1}">
                       <article
                            t-foreach="this.presets"
                            t-as="preset" t-key="preset.id"
                            t-on-click="() => this.selectPreset(preset)"
                            role="button"
                            class="preset_btn fs-2 fw-medium d-flex flex-column shadow-sm bg-white rounded cursor-pointer rounded-4 overflow-hidden"
                            t-att-class="{
                                'g-col-6': this.presets.length &lt; 3,
                                'g-col-4': this.presets.length &gt; 2,
                                'w-50': this.presets.length === 1
                            }">
                            <div class="position-relative img-container">
                                <div class="ratio ratio-1x1">
                                    <img t-if="preset.has_image" class="object-fit-cover" t-attf-src="/web/image/pos.preset/#{preset.id}/image_512?unique=#{preset.write_date}"/>
                                </div>
                                <span t-if="preset.service_at === 'counter' and preset.use_timing" class="badge text-bg-light p-2 m-2 bg-opacity-75 position-absolute bottom-0 end-0">
                                    Average time: <t t-esc="preset.interval_time"/> minutes
                                </span>
                            </div>
                           <span class="px-3 py-3 fw-bold text-center"  t-out="preset.name"/>
                       </article>
                    </div>
                    <div t-else="" class="d-flex flex-column gap-3">
                       <article
                            t-foreach="this.presets"
                            t-as="preset" t-key="preset.id"
                            t-on-click="() => this.selectPreset(preset)"
                            role="button"
                            class="preset_btn fs-2 fw-medium d-flex align-items-center bg-white shadow-sm rounded cursor-pointer rounded-4 overflow-hidden"
                            >
                            <div t-if="preset.has_image" class="w-25 ratio ratio-1x1 flex-shrink-0">
                                <img class="object-fit-cover" t-attf-src="/web/image/pos.preset/#{preset.id}/image_512?unique=#{preset.write_date} "/>
                            </div>
                            <div class="d-flex w-100">
                                <div class="ms-2 fw-bold"  t-esc="preset.name"/>
                                <div class="d-flex ms-auto me-2">
                                    <span t-if="preset.service_at === 'counter' and preset.use_timing" class="badge text-bg-info bg-opacity-75 align-content-center">
                                        <span class="fa fa-clock-o" /> <t t-esc="preset.interval_time"/> min
                                    </span>
                                </div>
                            </div>
                       </article>
                   </div>
                </div>
            </div>

            <div class="o_self_footer py-3" t-att-class="{'o_self_shadow_bottom': this.scrollShadow.bottom}">
                <div class="container o_self_container d-flex justify-content-between align-items-center position-relative" >
                    <button class="btn btn-lg btn-light btn-back border-light" t-on-click="()=>this.onClickBack()">
                        <i class="oi oi-chevron-left d-md-none" />
                        <span class="d-none d-md-inline">Back</span>
                    </button>
                </div>
            </div>

        </div>
    </t>
</templates>
