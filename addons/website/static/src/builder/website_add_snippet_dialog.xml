<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="website.AddSnippetDialog.header" t-inherit="web.Dialog.header" t-inherit-mode="primary">
    <xpath expr="//h4[hasclass('modal-title')]" position="after">
            <button class="btn border-0 d-flex align-items-center"
                    t-on-click="toggleMobilePreview"
                    t-att-class="{ 'text-success': this.state.isMobilePreviewMode }"
                    title="Mobile Preview"
                    aria-label="Mobile Preview">
                <i class="fa fa-mobile" style="font-size: 25px"/>
            </button>
    </xpath>
</t>

<t t-name="website.AddSnippetDialog" t-inherit="html_builder.AddSnippetDialog" t-inherit-mode="primary">
    <xpath expr="//Dialog" position="inside">
        <t t-set-slot="header" t-slot-scope="scope">
            <t t-call="website.AddSnippetDialog.header">
                <t t-set="dismiss" t-value="scope.close"/>
            </t>
        </t>
    </xpath>
</t>

</templates>
