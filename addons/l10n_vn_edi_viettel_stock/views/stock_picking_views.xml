<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_view_form_inherit_l10n_vn_edi_viettel_stock" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.l10n_vn_edi_viettel_stock</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_l10n_vn_send_to_sinvoice"
                    string="Send to SInvoice"
                    type="object"
                    class="btn-primary"
                    invisible="not l10n_vn_edi_show_send_button"
                />
            </xpath>
            <xpath expr="//page[@name='operations']//field[@name='quantity']" position="after">
                <field name="l10n_vn_edi_unit_price" optional="show"/>
                <field name="l10n_vn_edi_total_price" optional="hide"/>
            </xpath>
            <xpath expr="//page[@name='extra']" position="after">
               <page name="l10n_vn_edi_tab" string="E-Transfer Note" invisible="not l10n_vn_edi_show_send_button">
                    <separator string="SInvoice Symbol"/>
                    <group>
                        <group>
                            <field name="l10n_vn_edi_symbol_id"
                                options="{'no_open': True, 'no_create': True}"
                                readonly="l10n_vn_edi_state == 'sent'"/>
                            <field name="l10n_vn_edi_issue_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="l10n_vn_edi_state" readonly="1"/>
                            <field name="l10n_vn_edi_invoice_number" readonly="1"/>
                            <field name="l10n_vn_edi_reservation_code" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Order/Contract Information">
                            <field name="l10n_vn_edi_economic_contract_no"/>
                            <field name="l10n_vn_edi_command_date"/>
                            <field name="l10n_vn_edi_date"/>
                            <field name="l10n_vn_edi_command_of"/>
                            <field name="l10n_vn_edi_for_organization"/>
                            <field name="l10n_vn_edi_command_des"/>
                            <field name="l10n_vn_edi_contract_no"/>
                            <field name="l10n_vn_edi_invoice_note"/>
                        </group>
                        <group string="Vehicle">
                            <field name="l10n_vn_edi_vehicle"/>
                            <field name="l10n_vn_edi_transformer"/>
                            <field name="l10n_vn_edi_vehicle_number"/>
                            <field name="l10n_vn_edi_trip_number"/>
                        </group>
                    </group>
                    <group>
                        <group string="Dispatch Information">
                            <field name="l10n_vn_edi_export_at"/>
                            <field name="l10n_vn_edi_export_at_no"/>
                            <field name="l10n_vn_edi_bpx_kho"/>
                            <field name="l10n_vn_edi_exporter_name"/>
                            <field name="l10n_vn_edi_export_date"/>
                        </group>
                        <group string="Receipt Information">
                            <field name="l10n_vn_edi_import_at"/>
                            <field name="l10n_vn_edi_import_at_no"/>
                            <field name="l10n_vn_edi_import_date"/>
                            <field name="l10n_vn_edi_tax_code_buyer"/>
                        </group>
                    </group>
                    <group>
                        <group string="Goods">
                            <field name="l10n_vn_edi_quantity_certification"/>
                            <field name="l10n_vn_edi_date_certification"/>
                            <field name="l10n_vn_edi_data_of_seal"/>
                            <field name="l10n_vn_edi_number_of_seal"/>
                        </group>
                        <group string="Others">
                            <field name="l10n_vn_edi_object"/>
                            <field name="l10n_vn_edi_cua"/>
                            <field name="l10n_vn_edi_internal_no"/>
                            <field name="l10n_vn_edi_explain"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
