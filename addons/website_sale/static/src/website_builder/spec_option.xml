<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website_sale.SpecificationsOption">

    <!-- Field selector -->
    <BuilderRow label.translate="Field">
        <BuilderSelect dataAttributeAction="'pendingFieldId'" preview="false">
            <t t-foreach="state.fields" t-as="field" t-key="field.id">
                <BuilderSelectItem dataAttributeActionValue="`${field.id}`">
                    <t t-out="field.field_description"/>
                </BuilderSelectItem>
            </t>
        </BuilderSelect>
    </BuilderRow>

    <!-- Category selector + plus/times toggle -->
    <BuilderRow label.translate="Category">
        <BuilderSelect dataAttributeAction="'pendingCategoryId'" preview="false">
            <BuilderSelectItem dataAttributeActionValue="''">
                Others
            </BuilderSelectItem>
            <t t-foreach="categories" t-as="category" t-key="category.id">
                <BuilderSelectItem dataAttributeActionValue="`${category.id}`">
                    <t t-out="category.name"/>
                </BuilderSelectItem>
            </t>
        </BuilderSelect>
        <BuilderButton
            t-if="!categoryCreateMode.value"
            title.translate="Create new category"
            className="'fa fa-plus text-success border-0'"
            style="'background-color: transparent !important;'"
            preview="false"
            t-on-click="() => this.openCategoryCreate()"
        />
        <BuilderButton
            t-if="categoryCreateMode.value"
            title.translate="Cancel"
            className="'fa fa-times text-danger border-0'"
            style="'background-color: transparent !important;'"
            preview="false"
            t-on-click="() => this.cancelCategoryCreate()"
        />
    </BuilderRow>

    <!-- New category name input + Create button -->
    <t t-if="categoryCreateMode.value">
        <BuilderRow label.translate="Name" level="1">
            <BuilderTextInput
                dataAttributeAction="'pendingNewCategoryName'"
                placeholder.translate="Category name..."
            />
        </BuilderRow>
        <BuilderRow label.translate=" ">
            <BuilderButton
                action="'createCategory'"
                preview="false"
                type="'success'"
                className="'w-auto'"
            >
                Create Category
            </BuilderButton>
        </BuilderRow>
    </t>

    <!-- Add Field button — hidden while category create is open -->
    <t t-if="!categoryCreateMode.value">
        <BuilderRow label.translate=" ">
            <BuilderButton
                action="'addSpecField'"
                preview="false"
                type="'success'"
            >
                + Add Field
            </BuilderButton>
        </BuilderRow>
    </t>

    <!-- Added fields list -->
    <t t-if="extraFields.length">
        <BuilderRow label.translate="Added Fields">
            <div class="w-100 d-flex flex-column gap-1">
                <t t-foreach="extraFields" t-as="ef" t-key="ef.id">
                    <div class="d-flex align-items-center justify-content-between gap-2 p-1">
                        <div class="d-flex flex-column flex-grow-1 overflow-hidden">
                            <span class="small text-truncate"><t t-out="ef.label"/></span>
                            <span t-if="ef.category_id" class="text-truncate" style="font-size: 10px;">(<t t-out="ef.category_id[1]"/>)</span>
                        </div>
                        <BuilderButton
                            action="'removeSpecField'"
                            actionValue="`${ef.id}`"
                            preview="false"
                            className="'btn-danger flex-shrink-0 flex-grow-0 p-0'"
                            style="'width: 24px; height: 24px; min-width: unset;'"
                        >
                            <i class="fa fa-trash"/>
                        </BuilderButton>
                    </div>
                </t>
            </div>
        </BuilderRow>
    </t>

</t>

</templates>
